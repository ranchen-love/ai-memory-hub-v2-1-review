{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional aggregate summary",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "health_aggregate"
    },
    "source": {
      "$ref": "protocol.schema.json#/$defs/source"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "value": {
            "type": "number",
            "minimum": -1000000000000000,
            "maximum": 1000000000000000
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": [
          "metric",
          "unit",
          "value",
          "samples"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source",
    "period_from",
    "period_to",
    "observations"
  ],
  "additionalProperties": false
}
