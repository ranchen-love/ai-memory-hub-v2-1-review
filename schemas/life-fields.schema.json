        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_to": {
