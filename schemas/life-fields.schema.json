{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life archive field registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "life_field_registry"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "domains": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-2])-0[1-5]$"
            },
            "minProperties": 4,
            "maxProperties": 5,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(0[1-9]|1[0-2])-0[1-5]$"
                  },
                  "minItems": 1,
                  "maxItems": 5,
                  "uniqueItems": true
                },
                "type": {
                  "enum": [
                    "text",
                    "text_list",
                    "integer",
                    "date",
                    "reference",
                    "reference_list",
                    "enum",
                    "presence",
                    "presence_list"
                  ]
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "expected": {
                  "type": "boolean"
                },
                "source_hint": {
                  "enum": [
                    "reference",
                    "review",
                    "owner",
                    "evidence",
                    "system"
                  ]
                },
                "timing": {
                  "enum": [
                    "none",
                    "interval",
                    "point"
                  ]
                },
                "minimum_sensitivity": {
                  "enum": [
                    "public",
                    "internal",
                    "private",
                    "restricted"
                  ]
                }
              },
              "required": [
                "id",
                "domains",
                "type",
                "expected",
                "source_hint",
                "timing",
                "minimum_sensitivity"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "choices"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "choices"
                      ]
                    }
                  }
                }
              ]
            },
            "minItems": 10,
            "maxItems": 14
          }
        },
        "required": [
          "id",
          "label",
          "domains",
          "fields"
        ],
        "additionalProperties": false
      },
      "minItems": 12,
      "maxItems": 12
    }
  },
  "required": [
    "schema_version",
    "kind",
    "categories"
  ],
  "additionalProperties": false,
  "$defs": {
    "field_evidence": {
